generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  owner       String
  createdAt   DateTime @default(now())
  startedAt   DateTime

  @@map("projects")
}
